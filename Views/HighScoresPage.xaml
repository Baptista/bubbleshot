<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BubbleShot.ViewModels"
             xmlns:models="clr-namespace:BubbleShot.Models"
             x:Class="BubbleShot.Views.HighScoresPage"
             x:DataType="viewmodels:HighScoresViewModel"
             Title="High Scores"
             BackgroundColor="#1a1a2e">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,20,0,20">
            <Label Text="🏆 HIGH SCORES 🏆"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#FFD700" />
        </VerticalStackLayout>

        <!-- Scores List -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                 IsVisible="{Binding IsLoading}"
                                 Color="#4CAF50"
                                 WidthRequest="50"
                                 HeightRequest="50"
                                 HorizontalOptions="Center"
                                 Margin="0,50,0,0" />

                <CollectionView ItemsSource="{Binding HighScores}"
                              IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:HighScore">
                            <Grid Padding="10"
                                  BackgroundColor="#2a2a3e"
                                  Margin="0,5"
                                  ColumnDefinitions="50,*,80,100">

                                <Label Grid.Column="0"
                                       Text="{Binding Id}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#FFD700"
                                       Margin="0,0,15,0"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding PlayerName}"
                                       FontSize="18"
                                       TextColor="White"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="{Binding Score}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#4CAF50"
                                       Margin="0,0,15,0"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="3"
                                       Text="{Binding Level, StringFormat='Level {0}'}"
                                       FontSize="14"
                                       TextColor="#aaa"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                       Text="No high scores yet. Be the first!"
                       FontSize="16"
                       TextColor="#666"
                       HorizontalOptions="Center"
                       Margin="0,50,0,0">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                   Binding="{Binding HighScores.Count}"
                                   Value="0">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
            <Button Grid.Column="0"
                    Text="🔄 Refresh"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="10" />

            <Button Grid.Column="1"
                    Text="⬅️ Back"
                    Command="{Binding BackCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="10" />
        </Grid>

    </Grid>

</ContentPage>
